{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Proposed quiet, offline-first SOC investigation desk; not yet implemented.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.961,
          0.961,
          0.961
        ],
        "hex": "#f5f5f5"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.722,
          0.722,
          0.722
        ],
        "hex": "#b8b8b8"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.067,
          0.067
        ],
        "hex": "#111111"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.094,
          0.094,
          0.094
        ],
        "hex": "#181818"
      }
    },
    "raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.141,
          0.141,
          0.141
        ],
        "hex": "#242424"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.22,
          0.22,
          0.22
        ],
        "hex": "#383838"
      }
    },
    "control": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.459,
          0.459,
          0.459
        ],
        "hex": "#757575"
      }
    },
    "inverse": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.067,
          0.067
        ],
        "hex": "#111111"
      }
    },
    "critical": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.573,
          0.573
        ],
        "hex": "#ff9292"
      }
    },
    "critical-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.196,
          0.106,
          0.106
        ],
        "hex": "#321b1b"
      }
    },
    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.757,
          0.416
        ],
        "hex": "#e8c16a"
      }
    },
    "warning-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.188,
          0.161,
          0.098
        ],
        "hex": "#302919"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.553,
          0.831,
          0.667
        ],
        "hex": "#8dd4aa"
      }
    },
    "success-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.11,
          0.173,
          0.137
        ],
        "hex": "#1c2c23"
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.659,
          0.78,
          0.98
        ],
        "hex": "#a8c7fa"
      }
    },
    "info-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.118,
          0.161,
          0.22
        ],
        "hex": "#1e2938"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "section": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "meta": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Sans",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}