# ==============================================================================
# Arbiter Environment Configuration Template
# Copy this file to .env and customize for your environment.
# ==============================================================================

# Application Port & Host
PORT=8000
HOST=127.0.0.1

# Database Connection URI
# Option A: Standalone Docker profile (with docker compose --profile standalone up -d)
# DATABASE_URL=postgresql://arbiter:arbiter_password@127.0.0.1:5432/arbiter

# Option B: Existing local PostgreSQL or SOC AbuseIPDB database
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/abuseip

# Remote IP Intel DB (Neuropetra `ip_intel`). Use the read-only login role.
# Reachable from the host through the socat sidecar defined in the Neuropetra
# project (compose.dblink.yml: 127.0.0.1:5433 -> postgres:5432).
# REMOTE_DATABASE_URL=postgresql://ip_intel_read_login:CHANGE_ME@127.0.0.1:5433/ip_intel

# Local AI Assistance (Loopback only - Ollama)
ENABLE_LOCAL_AI=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# AbuseIPDB API Key (for Live Threat Intelligence Enrichment)
ABUSEIPDB_API_KEY=

# Encryption key for Wazuh / Remote database credentials at rest.
# Leave empty to let Arbiter generate a 0600 key file outside the repository:
#   local  : ~/.local/share/arbiter/secret.key
#   docker : /data/secret.key (persisted in the arbiter_secrets volume)
# Do NOT commit a real key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARBITER_SECRET_KEY=
