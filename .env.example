# ==============================================================================
# Arbiter Environment Configuration Template
# Copy this file to .env and customize for your environment.
# ==============================================================================

# Application Port & Host
PORT=8000
HOST=127.0.0.1

# Database Connection URI
# Option A: Standalone Docker profile (with docker compose --profile standalone up -d)
# DATABASE_URL=postgresql://arbiter:arbiter_password@127.0.0.1:5432/arbiter

# Option B: Existing local PostgreSQL or SOC AbuseIPDB database
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/abuseip

# Local AI Assistance (Loopback only - Ollama)
ENABLE_LOCAL_AI=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
